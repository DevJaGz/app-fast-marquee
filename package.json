{
  "name": "app-fast-marquee",
  "version": "0.1.0",
  "scripts": {
    "start": "ng serve",
    "build:app": "ng build app-fast-marquee",
    "build:lib": "ng build ngx-fast-marquee",
    "test:app": "ng test app-fast-marquee --watch=false",
    "test:lib": "ng test ngx-fast-marquee --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "node e2e/support/e2e-docker.mjs",
    "e2e:local": "ng e2e",
    "prepare": "husky install",
    "format": "prettier --write \"**/*.{json,html,ts,scss}\"",
    "prettier:fix": "npm run format && npm run lint:fix",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "projects/ngx-fast-marquee/**/*.{ts,html}": [
      "prettier --write",
      "eslint --fix --config projects/ngx-fast-marquee/.eslintrc.json"
    ],
    "server.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "build12/**/*.{ts,html}": "prettier --write",
    "*.{json,scss}": "prettier --write"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=9.5.1",
    "pnpm": ">=8.6.12"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/platform-server": "^20.3.25",
    "@angular/router": "^20.3.25",
    "@angular/ssr": "^20.3.31",
    "express": "^5.1.0",
    "rxjs": "~7.8.1",
    "tailwindcss-animated": "^1.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.31",
    "@angular-eslint/builder": "19.8.1",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-eslint/schematics": "19.8.1",
    "@angular-eslint/template-parser": "19.8.1",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.25",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jasmine-core": "~5.1.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.0.8",
    "ng-packagr": "^20.3.2",
    "playwright-ng-schematics": "1.3.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "prettier-eslint": "^15.0.1",
    "tailwindcss": "^3.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
